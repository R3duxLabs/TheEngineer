
run = "python main.py"
language = "python3"
entrypoint = "main.py"
modules = ["nodejs-20", "python-3.11"]

[nix]
channel = "stable-23_11"
packages = ["python311Packages.uvicorn", "zip"]

[deployment]
run = "python main.py --web"
deploymentTarget = "cloudrun"
ignorePorts = false

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8888
externalPort = 3000

[workflows]
runButton = "Run API"

[[workflows.workflow]]
name = "Run"
author = 42203843
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py --web"

[[workflows.workflow]]
name = "Run API"
author = 42203843
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
